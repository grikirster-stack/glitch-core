## Не печатать строку `[Lore] …` при генерации (тесты гоняют сотни сидов).
var quiet: bool = false
## Время последней генерации, мс.
var last_gen_ms: float = 0.0

var _crew: Array = []
var _impostor: Dictionary = {}
var _places: Dictionary = {}
var _ruin_owner: Array = []          ## i-я руина → индекс хозяина в _crew
var _chapters: Array = []            ## тексты глав (String)
var _chapter_meta: Array = []        ## [{author: int, subject: int, place: String}]
var _ep_pick: Array = [0, 0, 0]      ## выбранные абзацы эпилога
var _epitaph_order: Array = []
var _epitaph_n: int = 0
var _epitaph_rng: RandomNumberGenerator = RandomNumberGenerator.new()
var _seed: int = 0
var _built: bool = false
var _world_seed_seen: int = 0

## Экипаж «Кербер-9»: 7 словарей {idx, role, name, name_r/d/v/t (падежи), surname,
## surname_m, surname_gen, callsign, gender ("m"/"f"), impostor, full}. Порядок и роли фиксированы.
var crew: Array:
	get:
		_ensure()
		return _crew

## Тот самый «не тот»: ссылка на словарь из `crew`. Никогда не автор записей.
var impostor: Dictionary:
	get:
		_ensure()
		return _impostor


# ----------------------------------------------------------------------------
# ПУБЛИЧНЫЙ API
# ----------------------------------------------------------------------------

## Собирает лор по сиду. Вызывать вручную не нужно: Lore сам пересоберётся,
## когда сменится `World.world_seed`. Прямой вызов нужен инструментам (тесты, дамп).
func generate(p_seed: int) -> void:
	var t0: int = Time.get_ticks_usec()
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = p_seed ^ SEED_SALT
	_seed = p_seed
	_built = true
	_world_seed_seen = World.world_seed
	_make_crew(rng)
	_make_places(rng)
	_make_chapters(rng)
	_ep_pick = [rng.randi() % EPILOGUE_A.size(), rng.randi() % EPILOGUE_B.size(), rng.randi() % EPILOGUE_C.size()]
	_epitaph_order = range(EPITAPHS.size())
	_shuffle(_epitaph_order, rng)
	_epitaph_n = 0
	_epitaph_rng = RandomNumberGenerator.new()
	_epitaph_rng.seed = (p_seed ^ SEED_SALT) + 1
	last_gen_ms = float(Time.get_ticks_usec() - t0) / 1000.0
	if not quiet:
		print("[Lore] сид=%d экипаж=%d глав=%d обрывков=%d шаблонов=%d за %.2f мс" % [
				p_seed, _crew.size(), _chapters.size(), FRAGMENTS.size(), template_count(), last_gen_ms])


## Число глав журнала (9: два терминала базы + семь руин).
func chapter_count() -> int:
	return CHAPTERS.size()


## Текст главы i (0..8): 3–5 фраз без заголовка. Пустая строка, если i вне диапазона.
func chapter(i: int) -> String:
	_ensure()
	if i < 0 or i >= _chapters.size():
		return ""
	return String(_chapters[i])


## Название главы i.
func chapter_title(i: int) -> String:
	if i < 0 or i >= CHAPTERS.size():
		return ""
	return String(CHAPTERS[i]["title"])


## Автор главы i (словарь из `crew`; никогда не «не тот»). Пустой словарь, если i вне диапазона.
func chapter_author(i: int) -> Dictionary:
	_ensure()
	if i < 0 or i >= _chapter_meta.size():
		return {}
	return _crew[int(_chapter_meta[i]["author"])]


## Где лежит глава i: имя места (базовый терминал или руина).
func chapter_place(i: int) -> String:
	_ensure()
	if i < 0 or i >= _chapter_meta.size():
		return ""
	return String(_chapter_meta[i]["place"])


## Хозяин i-й руины (словарь из `crew`): от его роли зависит тип руины.
func ruin_owner(i: int) -> Dictionary:
	_ensure()
	return _crew[int(_ruin_owner[posmod(i, _ruin_owner.size())])]


## Имя места: kind — "crystal" (кристальный биом), "tunnel" (0..3), "ruin" (0..6),
## "base" (0 — лагерь, 1 — посадочная площадка). Индекс замыкается по кругу.
func place_name(kind: String, i: int) -> String:
	_ensure()
	if not _places.has(kind):
		return "Неизвестное место"
	var arr: Array = _places[kind]
	if arr.is_empty():
		return "Неизвестное место"
	return String(arr[posmod(i, arr.size())])


## Число обрывков для чёрных ящиков (20).
func fragment_count() -> int:
	return FRAGMENTS.size()


## Случайный обрывок. Всё случайное берётся из переданного rng: тот же rng — тот же обрывок.
func fragment(rng: RandomNumberGenerator) -> String:
	return fragment_at(rng.randi() % FRAGMENTS.size(), rng)


## Обрывок номер i (0..19): автор, «герой», руда, места и число берутся из rng.
func fragment_at(i: int, rng: RandomNumberGenerator) -> String:
	_ensure()
	var pool: Array = []
	for c in _crew:
		if not c["impostor"]:
			pool.append(c)
	var author: Dictionary = pool[rng.randi() % pool.size()]
	var rest: Array = []
	for c in _crew:
		if c["idx"] != author["idx"]:
			rest.append(c)
	var subject: Dictionary = rest[rng.randi() % rest.size()]
	var ctx: Dictionary = _make_ctx(author, subject)
	var ore: Array = ORES[rng.randi() % ORES.size()]
	ctx["руда"] = ore[0]
	ctx["руда_р"] = ore[1]
	ctx["место"] = _q(place_name("ruin", rng.randi() % RUIN_COUNT))
	ctx["тоннель"] = _q(place_name("tunnel", rng.randi() % TUNNEL_COUNT))
	ctx["пустошь"] = _q(place_name("crystal", 0))
	ctx["n"] = rng.randi_range(2, 9)
	return _render(String(FRAGMENTS[posmod(i, FRAGMENTS.size())]), ctx)


## Эпитафия для экрана смерти. Каждый вызов — следующая строка из перемешанного
## сидом порядка; «герой» — член экипажа, но не «не тот». Тот же сид — та же последовательность.
func epitaph() -> String:
	_ensure()
	var pool: Array = []
	for c in _crew:
		if not c["impostor"]:
			pool.append(c)
	var who: Dictionary = pool[_epitaph_rng.randi() % pool.size()]
	var tpl: String = String(EPITAPHS[int(_epitaph_order[_epitaph_n % _epitaph_order.size()])])
	_epitaph_n += 1
	var ctx: Dictionary = _make_ctx(who, who)
	ctx["место"] = _q(place_name("ruin", _epitaph_rng.randi() % RUIN_COUNT))
	return _render(tpl, ctx)


## Эпилог для экрана победы: «Из 7 членов экипажа орбита услышала одного…» + судьба
## «не того» + автор последней главы + статистика. `stats`: days, kills, deaths (числа),
## time (секунды) — любые ключи можно не передавать. Абзацы разделены «\n».
func epilogue(stats: Dictionary) -> String:
	_ensure()
	var last: Dictionary = _chapter_meta[_chapter_meta.size() - 1]
	var ctx: Dictionary = _make_ctx(_crew[int(last["author"])], _impostor)
	ctx["n"] = _crew.size()
	ctx["место"] = _q(place_name("base", 0))
	var lines: PackedStringArray = PackedStringArray()
	lines.append(_render(String(EPILOGUE_A[int(_ep_pick[0])]), ctx))
	lines.append(_render(String(EPILOGUE_B[int(_ep_pick[1])]), ctx))
	lines.append(_render(String(EPILOGUE_C[int(_ep_pick[2])]), ctx))
	var extra: String = _stats_line(stats)
	if extra != "":
		lines.append(extra)
	return "\n".join(lines)


## Падежи выдуманного имени: {r, d, v, t} — родительный, дательный, винительный,
## творительный. Мужские имена кончаются на согласную, женские — на «а» или «я».
func decline(first_name: String, female: bool) -> Dictionary:
	if not female:
		return {"r": first_name + "а", "d": first_name + "у", "v": first_name + "а", "t": first_name + "ом"}
	var stem: String = first_name.substr(0, first_name.length() - 1)
	if first_name.ends_with("я"):
		return {"r": stem + "и", "d": stem + "е", "v": stem + "ю", "t": stem + "ей"}
	# после г, к, х, ж, ч, ш, щ пишется «и», а не «ы»
	var gen_end: String = "и" if "гкхжчшщ".contains(stem.substr(stem.length() - 1)) else "ы"
	return {"r": stem + gen_end, "d": stem + "е", "v": stem + "у", "t": stem + "ой"}


## Число шаблонных строк во всех словарях (для замеров «объём словарей»).
func template_count() -> int:
	var n: int = 0
	for chap in CHAPTERS:
		for v in chap["variants"]:
			n += v.size()
	n += FRAGMENTS.size() + EPITAPHS.size()
	n += EPILOGUE_A.size() + EPILOGUE_B.size() + EPILOGUE_C.size() + EPILOGUE_STATS.size()
	return n


## Разворачивает шаблон по правилам из шапки файла. `vars` — подстановки; для рода:
## "_ga" (автор), "_gs" («герой»), "_gi" («не тот») со значением "m" или "f";
## число для {#…} берётся из "n". Открыт для тестов согласования рода и числа.
func render(tpl: String, vars: Dictionary = {}) -> String:
	return _render(tpl, vars)


