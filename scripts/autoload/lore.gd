## Лениво пересобирает лор, если с прошлого обращения сменился сид мира.
func _ensure() -> void:
	var ws: int = World.world_seed
	if not _built or ws != _world_seed_seen:
		generate(ws)


func _make_crew(rng: RandomNumberGenerator) -> void:
	_crew = []
	var names_used: Dictionary = {}
	var surnames_used: Dictionary = {}
	var signs: Array = CALLSIGNS.duplicate()
	_shuffle(signs, rng)
	for i in ROLES.size():
		var female: bool = rng.randf() < 0.5
		var first: String = _unique_name(rng, female, names_used)
		var base: String = _unique_surname(rng, surnames_used)
		var sur: String = _surname_for(base, female)
		var cases: Dictionary = decline(first, female)
		var c: Dictionary = {
			"idx": i,
			"role": ROLES[i],
			"name": first,
			"name_r": cases["r"],
			"name_d": cases["d"],
			"name_v": cases["v"],
			"name_t": cases["t"],
			"surname": sur,
			"surname_m": base,
			"surname_gen": _surname_gen(base, female),
			"callsign": signs[i],
			"gender": "f" if female else "m",
			"impostor": false,
			"full": first + " " + sur,
		}
		_crew.append(c)
	var bad: int = rng.randi() % _crew.size()
	_crew[bad]["impostor"] = true
	_impostor = _crew[bad]


func _unique_name(rng: RandomNumberGenerator, female: bool, used: Dictionary) -> String:
	var s: String = ""
	for attempt in 30:
		s = String(NAME_START[rng.randi() % NAME_START.size()])
		if rng.randf() < 0.5:
			s += String(NAME_MID[rng.randi() % NAME_MID.size()])
		var ends: Array = NAME_END_F if female else NAME_END_M
		s += String(ends[rng.randi() % ends.size()])
		if not used.has(s):
			break
	used[s] = true
	return s


func _unique_surname(rng: RandomNumberGenerator, used: Dictionary) -> String:
	var s: String = ""
	for attempt in 30:
		s = String(SUR_STEM[rng.randi() % SUR_STEM.size()])
		if rng.randf() < 0.45:
			s += String(SUR_MID[rng.randi() % SUR_MID.size()])
		s += String(SUR_END[rng.randi() % SUR_END.size()])
		if not used.has(s):
			break
	used[s] = true
	return s


## Женская форма фамилии: Волов → Волова, Громский → Громская.
func _surname_for(base: String, female: bool) -> String:
	if not female:
		return base
	if base.ends_with("ский"):
		return base.substr(0, base.length() - 2) + "ая"
	return base + "а"


## Родительный падеж («Шахта Вольской»): Волов → Волова, Волова → Воловой, Громская → Громской.
func _surname_gen(base: String, female: bool) -> String:
	var skiy: bool = base.ends_with("ский")
	if female:
		if skiy:
			return base.substr(0, base.length() - 2) + "ой"
		return base + "ой"
	if skiy:
		return base.substr(0, base.length() - 2) + "ого"
	return base + "а"


func _make_places(rng: RandomNumberGenerator) -> void:
	_places = {}
	_places["base"] = BASE_NAMES.duplicate()
	_places["crystal"] = [
		String(CRYSTAL_ADJ[rng.randi() % CRYSTAL_ADJ.size()]) + " " + String(CRYSTAL_NOUN[rng.randi() % CRYSTAL_NOUN.size()]),
	]
	# Хозяин руины — перестановка экипажа: у каждого члена ровно одна руина.
	_ruin_owner = range(ROLES.size())
	_shuffle(_ruin_owner, rng)
	var ruins: Array = []
	for i in RUIN_COUNT:
		var holder: Dictionary = _crew[int(_ruin_owner[i])]
		var types: Array = RUIN_TYPES[holder["role"]]
		var t: String = String(types[rng.randi() % types.size()])
		if rng.randf() < 0.5:
			ruins.append(t + " " + String(holder["surname_gen"]))
		else:
			ruins.append("%s %d-%s" % [t, rng.randi_range(1, 9), LETTERS[rng.randi() % LETTERS.size()]])
	_places["ruin"] = ruins
	var tunnels: Array = []
	var guard: int = 0
	while tunnels.size() < TUNNEL_COUNT and guard < 60:
		guard += 1
		var tt: String = String(TUNNEL_TYPES[rng.randi() % TUNNEL_TYPES.size()])
		var nm: String = ""
		if rng.randf() < 0.5:
			nm = "%s %d-%s" % [tt, rng.randi_range(1, 9), LETTERS[rng.randi() % LETTERS.size()]]
		else:
			nm = tt + " " + String(_crew[rng.randi() % _crew.size()]["surname_gen"])
		if not tunnels.has(nm):
			tunnels.append(nm)
	while tunnels.size() < TUNNEL_COUNT:
		tunnels.append("Тоннель %d" % (tunnels.size() + 1))
	_places["tunnel"] = tunnels


func _make_chapters(rng: RandomNumberGenerator) -> void:
	_chapters = []
	_chapter_meta = []
	var imp: int = int(_impostor["idx"])
	for i in CHAPTERS.size():
		var chap: Dictionary = CHAPTERS[i]
		# Автор: в руине — её хозяин (если он не «не тот»), на базе — по ролям.
		var author: Dictionary
		if i < BASE_TERMINALS:
			author = _pick_role(chap["authors"], [imp])
		else:
			var holder: int = int(_ruin_owner[i - BASE_TERMINALS])
			author = _crew[holder] if holder != imp else _next_non_impostor(holder)
		# «Герой» записи: по ролям, но не сам автор; пустой список — «не тот».
		var prefs: Array = chap["subject"]
		var subject: Dictionary = _impostor
		if not prefs.is_empty():
			subject = _pick_role(prefs, [int(author["idx"])])
		var variants: Array = chap["variants"]
		var v: Array = variants[rng.randi() % variants.size()]
		var span: Array = chap["n"]
		var ore: Array = ORES[rng.randi() % ORES.size()]
		var place: String = _place_of(i)
		var ctx: Dictionary = _make_ctx(author, subject)
		ctx["n"] = rng.randi_range(int(span[0]), int(span[1]))
		ctx["руда"] = ore[0]
		ctx["руда_р"] = ore[1]
		ctx["место"] = _q(place)
		ctx["тоннель"] = _q(place_name("tunnel", rng.randi() % TUNNEL_COUNT))
		ctx["пустошь"] = _q(place_name("crystal", 0))
		var parts: PackedStringArray = PackedStringArray()
		for phrase in v:
			parts.append(_render(String(phrase), ctx))
		_chapters.append(" ".join(parts))
		_chapter_meta.append({"author": int(author["idx"]), "subject": int(subject["idx"]), "place": place})


## Место, где лежит глава i: два терминала базы, дальше — руины по порядку.
func _place_of(i: int) -> String:
	if i < BASE_TERMINALS:
		return String(_places["base"][i])
	return String(_places["ruin"][i - BASE_TERMINALS])


## Первый член экипажа с одной из ролей (по порядку предпочтения), кроме запрещённых;
## если таких нет — первый разрешённый.
func _pick_role(roles: Array, banned: Array) -> Dictionary:
	for r in roles:
		for c in _crew:
			if c["role"] == r and not banned.has(int(c["idx"])):
				return c
	for c in _crew:
		if not banned.has(int(c["idx"])):
			return c
	return _crew[0]


## Следующий за from_idx член экипажа, который не «не тот».
func _next_non_impostor(from_idx: int) -> Dictionary:
	var n: int = _crew.size()
	for k in range(1, n + 1):
		var c: Dictionary = _crew[(from_idx + k) % n]
		if not c["impostor"]:
			return c
	return _crew[0]


## Общая часть подстановок. «Герой» (subject) даёт {имя}/{фамилия}/{роль}/{позывной}.
func _make_ctx(author: Dictionary, subject: Dictionary) -> Dictionary:
	return {
		"имя": subject["name"],
		"имя_р": subject["name_r"],
		"имя_д": subject["name_d"],
		"имя_в": subject["name_v"],
		"имя_т": subject["name_t"],
		"фамилия": subject["surname"],
		"роль": subject["role"],
		"Роль": _cap(String(subject["role"])),
		"позывной": subject["callsign"],
		"тот": _impostor["name"],
		"тот_р": _impostor["name_r"],
		"тот_д": _impostor["name_d"],
		"тот_в": _impostor["name_v"],
		"тот_т": _impostor["name_t"],
		"автор": author["name"],
		"автор_роль": author["role"],
		"автор_позывной": author["callsign"],
		"_ga": author["gender"],
		"_gs": subject["gender"],
		"_gi": _impostor["gender"],
	}


func _stats_line(stats: Dictionary) -> String:
	var parts: PackedStringArray = PackedStringArray()
	var days: int = int(stats.get("days", 0))
	if days > 0:
		parts.append(_render(String(EPILOGUE_STATS["days"]), {"n": days}))
	var kills: int = int(stats.get("kills", 0))
	if kills > 0:
		parts.append(_render(String(EPILOGUE_STATS["kills"]), {"n": kills}))
	var deaths: int = int(stats.get("deaths", 0))
	if deaths > 0:
		parts.append(_render(String(EPILOGUE_STATS["deaths"]), {"n": deaths}))
	var secs: float = float(stats.get("time", 0.0))
	if secs > 0.0:
		parts.append(_render(String(EPILOGUE_STATS["time"]), {"n": maxi(1, roundi(secs / 60.0))}))
	return " ".join(parts)


# --- шаблонизатор ------------------------------------------------------------

func _render(tpl: String, ctx: Dictionary) -> String:
	var out: String = ""
	var pos: int = 0
	while true:
		var a: int = tpl.find("{", pos)
		if a < 0:
			out += tpl.substr(pos)
			break
		out += tpl.substr(pos, a - pos)
		var b: int = tpl.find("}", a)
		if b < 0:
			out += tpl.substr(a)
			break
		out += _token(tpl.substr(a + 1, b - a - 1), ctx)
		pos = b + 1
	return out


## Один токен без скобок: «имя», «решил|решила», «~он|она», «#час|часа|часов».
func _token(body: String, ctx: Dictionary) -> String:
	if body.begins_with("#"):
		var forms: PackedStringArray = body.substr(1).split("|")
		if forms.size() == 3:
			return _plural(int(ctx.get("n", 0)), forms)
		return "{" + body + "}"
	if body.find("|") >= 0:
		var who: String = "_ga"
		var rest: String = body
		if rest.begins_with("~"):
			who = "_gs"
			rest = rest.substr(1)
		elif rest.begins_with("^"):
			who = "_gi"
			rest = rest.substr(1)
		var pair: PackedStringArray = rest.split("|")
		if pair.size() == 2:
			if String(ctx.get(who, "m")) == "f":
				return pair[1]
			return pair[0]
		return "{" + body + "}"
	if ctx.has(body):
		return str(ctx[body])
	return "{" + body + "}"


## Форма существительного по числу: forms = [«час», «часа», «часов»].
func _plural(n: int, forms: PackedStringArray) -> String:
	var m100: int = n % 100
	var m10: int = n % 10
	if m100 >= 11 and m100 <= 14:
		return forms[2]
	if m10 == 1:
		return forms[0]
	if m10 >= 2 and m10 <= 4:
		return forms[1]
	return forms[2]


func _q(s: String) -> String:
	return "«" + s + "»"


func _cap(s: String) -> String:
	if s.is_empty():
		return s
	return s.substr(0, 1).to_upper() + s.substr(1)


## Перемешивание Фишера — Йетса на переданном rng (Array.shuffle берёт глобальный).
func _shuffle(arr: Array, rng: RandomNumberGenerator) -> void:
	for i in range(arr.size() - 1, 0, -1):
		var j: int = rng.randi_range(0, i)
		var tmp: Variant = arr[i]
		arr[i] = arr[j]
		arr[j] = tmp
